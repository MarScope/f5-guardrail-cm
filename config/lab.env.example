# Lab values for docs/ai-security-eks-lab-guide.md.
# Step 1.3 copies this file to ~/f5-ai-lab/lab.env. Keep that copy private: it holds secrets.
#
# Load it in every new terminal:   source ~/f5-ai-lab/lab.env
# Helper commands are described at the bottom of this file.

if [ -z "${BASH_VERSION:-}" ]; then
  echo "WARNING: the lab commands are written for bash, and this terminal is running a different shell."
  echo "         Type:  bash   and press Enter, then run:  source ~/f5-ai-lab/lab.env"
fi

# --- AWS (step 1.4) ---
# export AWS_PROFILE="f5-ai-lab"
export AWS_REGION="us-east-1"
export CLUSTER_NAME="f5-guardrails-CHANGEME"

# --- Amazon Bedrock (model checked in step 1.6, API key created in step 3.1) ---
export BEDROCK_REGION="us-east-1"
export BEDROCK_MODEL="openai.gpt-oss-120b-1:0"
export BEDROCK_API_KEY="NOT-SET"

# --- F5 AI Security (Sections 2 and 3) ---
export F5_HOST="guardrails.ailab.test"
export F5_CA="$HOME/f5-ai-lab/guardrails-lab.crt"
export F5_CONNECTION="bedrock-lab"
export F5_BASELINE_TOKEN="NOT-SET"
export F5_PROTECTED_TOKEN="NOT-SET"

# Helper commands: labvar, labcfg, labsecrets, labrefresh.
# They are defined in the repository so that "git pull" keeps them current.
if [ -f "$HOME/f5-ai-lab/f5-guardrail-cm/scripts/lab-helpers.sh" ]; then
  source "$HOME/f5-ai-lab/f5-guardrail-cm/scripts/lab-helpers.sh"
else
  echo "WARNING: lab helper commands not found. Is the repository at ~/f5-ai-lab/f5-guardrail-cm ?"
fi
