# F5 AI Security Guardrails PoC automation config.
# Copy to config/guardrails-poc.env and adjust if needed.
#
# Secrets can be supplied either through files or environment variables:
# - Harbor credentials file format: first non-empty line is username, second is password.
# - License file format: entire file content is the license string.
# - Environment override variables: HARBOR_USERNAME, HARBOR_PASSWORD, F5_LICENSE_STRING.

AWS_REGION="us-east-1"
CLUSTER_NAME="f5-guardrails-poc"
K8S_VERSION="1.35"

GUARDRAIL_NODEGROUP_NAME="guardrails-gpu-ng"
GUARDRAIL_NODE_TYPE="g5.4xlarge"
GUARDRAIL_NODE_COUNT="1"
GUARDRAIL_NODE_MIN="1"
GUARDRAIL_NODE_MAX="1"
GUARDRAIL_NODE_VOLUME_SIZE="150"
NODE_AMI_FAMILY="AmazonLinux2023"
VPC_NAT_MODE="Disable"

HOSTNAME="guardrails.f5demo.io"
ROUTE53_ENABLED="false"
ROUTE53_ZONE_NAME="f5demo.io"
ROUTE53_HOSTED_ZONE_ID="Z01552491KU67A60QQPXC"

# Restrict the internet-facing load balancer to specific source addresses.
# "auto" is the public IP of the machine that runs this script, detected at run time.
# Add more IPv4 addresses or CIDRs separated by spaces or commas, for example
# "auto 203.0.113.0/24". After your IP changes, run: ./scripts/guardrails-poc.sh access
RESTRICT_INGRESS_SOURCE="true"
ALLOWED_SOURCE_CIDRS="auto"

# Credentials the platform ships with. The script uses them once to sign in and
# replace the password before the ingress is created.
GUARDRAILS_DEFAULT_USERNAME="admin"
GUARDRAILS_DEFAULT_PASSWORD="pass"

# Keycloak realms where the initial password is replaced.
# Passwords are realm-specific.
GUARDRAILS_AUTH_REALMS="master calypsoai"

# Replace the initial password during `up`, before the platform is exposed.
# The new password is taken from the GUARDRAILS_ADMIN_PASSWORD environment variable,
# or from the first line of ADMIN_PASSWORD_FILE. If neither exists, a random password
# is generated and written to ADMIN_PASSWORD_FILE.
ROTATE_DEFAULT_PASSWORD="true"
ADMIN_PASSWORD_FILE=".secrets/admin-password"
# Set to "true" only if `up` must continue when the password could not be replaced.
ALLOW_DEFAULT_PASSWORD="false"

ENABLE_RED_TEAM="false"
RED_TEAM_NODEGROUP_NAME="redteam-gpu-ng"
RED_TEAM_NODE_TYPE="g6e.2xlarge"
RED_TEAM_NODE_COUNT="1"
RED_TEAM_NODE_MIN="1"
RED_TEAM_NODE_MAX="1"
RED_TEAM_NODE_VOLUME_SIZE="150"

HARBOR_REGISTRY="harbor.calypsoai.app"
HARBOR_CREDENTIALS_FILE="config/harbor.txt"
F5_LICENSE_FILE="config/license.txt"

F5_NAMESPACE="f5-ai-sec"
MODERATOR_NAMESPACE="cai-moderator"
PREFECT_NAMESPACE="prefect"
INFERENCE_NAMESPACE="f5-ai-sec-inference"
INGRESS_NAMESPACE="nginx-ingress"

OPERATOR_RELEASE="f5-ai-security-operator"
OPERATOR_CHART="oci://harbor.calypsoai.app/calypsoai/f5-ai-security-operator-helm"
OPERATOR_CHART_VERSION="1.10.0"

INGRESS_RELEASE="nginx-ingress"
INGRESS_CHART="nginx-stable/nginx-ingress"
INGRESS_REPO_NAME="nginx-stable"
INGRESS_REPO_URL="https://helm.nginx.com/stable"
INGRESS_CONTROLLER_SERVICE="nginx-ingress-controller"
INGRESS_CONTROLLER_DEPLOYMENT="nginx-ingress-controller"

SECURITY_OPERATOR_NAME="security-operator-demo"
POSTGRES_STORAGE_CLASS="gp2"
POSTGRES_PASSWORD_FILE=".secrets/postgres-password"

# Set to "true" if you want the script to regenerate the self-signed certificate on each up run.
RECREATE_TLS_SECRET="false"

# Delete available EBS volumes still tagged as owned by this PoC cluster after teardown.
CLEANUP_LEFTOVER_EBS_VOLUMES="true"

# Inference pod start-up
# The model images are very large. If a model pod sits in CreateContainerError
# for STUCK_POD_GRACE_SECONDS, "up" deletes it so it restarts cleanly, at most
# STUCK_POD_MAX_RECYCLES times. Set RECYCLE_STUCK_INFERENCE_PODS="false" to
# turn this off.
RECYCLE_STUCK_INFERENCE_PODS="true"
STUCK_POD_GRACE_SECONDS="300"
STUCK_POD_MAX_RECYCLES="3"
INFERENCE_WAIT_SECONDS="1800"
